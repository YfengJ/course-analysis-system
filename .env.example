# Runtime data should live outside the source tree in production.
COURSE_SYSTEM_DATA_DIR=/path/to/course-system-data

# The application generates and persists a random SECRET_KEY when this is empty.
# SECRET_KEY=replace-with-a-random-secret
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-a-temporary-strong-password
SESSION_COOKIE_SECURE=false

# Optional intelligent suggestion service. Remote services must use HTTPS.
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=45
LLM_VERIFY_SSL=true
